# Copy this file to .env and fill in CAMERA_URL. All other values are
# optional — defaults shown match the recommended setup. Full reference:
# docs/configuration.md
#
# Tip: the parking_configurator tool generates a .env tailored to your
# camera (CAMERA_URL + BEV calibration). You can drop it in as-is.

# --- Required ---
CAMERA_URL=rtsp://user:password@192.168.0.1:554/stream

# --- BEV calibration (optional — exported by parking_configurator) ---
# 4 source-frame corners [TL, TR, BR, BL] as JSON. Coordinates may be
# negative or beyond original frame bounds. If omitted, the reference-
# deployment defaults in config.py are used.
# SRC_POINTS=[[-303,-163],[2070,339],[3165,1062],[831,1250]]
# BEV_WIDTH=1200                  # output canvas width  (must match mask PNG)
# BEV_HEIGHT=800                  # output canvas height (must match mask PNG)

# --- Detection tuning (optional) ---
# CAR_WIDTH=150                   # car footprint in BEV pixels
# CAR_HEIGHT=80
# CHECK_STEP=20                   # grid stride for free-spot scan
# DETECTION_ANCHOR=bottom_right   # bottom_right | bottom_center
# CONF_THRESHOLD=0.35             # min YOLO detection confidence
# OVERLAP_THRESHOLD=0.8           # duplicate-bbox suppression (1.0 disables)

# --- Pipeline behaviour (optional) ---
# ANALYSIS_INTERVAL=1.0           # seconds between pipeline runs while active
# IDLE_TIMEOUT=30.0               # seconds of no /state polls before pipeline pauses
# STALE_THRESHOLD=10.0            # seconds before a snapshot is marked stale
# HEARTBEAT_INTERVAL=3600.0       # idle-time background snapshot interval (0 disables)

# --- Storage (optional) ---
# Default: <project_root>/data/parking_history.db (cross-platform).
# Docker deployments set DB_PATH=/data/parking_history.db automatically
# (see docker-compose.yml) to land on the persistent bind-mount.
# DB_PATH=./data/parking_history.db
# RECORD_INTERVAL=120.0           # min seconds between DB writes while active
# RETENTION_DAYS=90               # auto-delete snapshots older than N days

# --- HTTP (optional) ---
# CORS_ORIGINS=*                  # comma-separated, or "*"

# --- Temporal hysteresis (optional, on by default) ---
# Smooths single-frame YOLO misses. See docs/temporal-smoothing.md
# TEMPORAL_SMOOTH_ENABLED=true
# TEMPORAL_WINDOW_N=5             # rolling window size in frames
# TEMPORAL_MIN_K=3                # min frames a bbox must appear in to survive
# TEMPORAL_IOU_MATCH=0.3          # IoU threshold for matching bboxes across frames
# TEMPORAL_MAX_AGE_SECONDS=10.0   # drop history entries older than this
